{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BlogDb": "Data Source=localhost;Initial Catalog=BlogDb;TrustServerCertificate=true;Integrated Security=true"
  },
  "JWTSettings": {
    "SecretKey": "<your-secret-key-min-32-random-chars>",
    "Issuer": "BlogApi",
    "DurationMinutes": 60
  },
  "EmailSettings": {
    "FromEmail": "<your-gmail-address>",
    "AppPassword": "<gmail-app-password-16-chars>"
  }
}
